# Copy to .env.local and edit as needed. Used by Vite (npm run dev and build).

# --- LOCALHOST (default for npm run dev) ---
# No vars needed: frontend uses http://localhost:5000.

# --- Use LIVE backend from local frontend (optional) ---
# VITE_USE_LIVE_BACKEND=true
# VITE_API_URL=https://your-backend.example.com

# --- PRODUCTION BUILD ---
# Required for production builds (no hardcoded fallback):
# VITE_API_URL=https://your-backend.example.com
