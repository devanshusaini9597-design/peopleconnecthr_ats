{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "frontend-self-one-14.vercel.app" }],
      "destination": "https://www.peopleconnecthr.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "frontend-self-one-14.vercel.app" }],
      "destination": "https://www.peopleconnecthr.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "peopleconnecthr.com" }],
      "destination": "https://www.peopleconnecthr.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "peopleconnecthr.com" }],
      "destination": "https://www.peopleconnecthr.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/((?!assets/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://api.stripe.com https://challenges.cloudflare.com https://peopleconnecthrats-production.up.railway.app; frame-src 'self' blob: data: about: https://js.stripe.com https://hooks.stripe.com https://challenges.cloudflare.com https://peopleconnecthrats-production.up.railway.app https://www.peopleconnecthr.com; child-src 'self' blob: data: about:; worker-src 'self' blob:; object-src 'self' blob:; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://peopleconnecthrats-production.up.railway.app/api/:path*"
    },
    {
      "source": "/candidates",
      "destination": "https://peopleconnecthrats-production.up.railway.app/candidates"
    },
    {
      "source": "/candidates/:path*",
      "destination": "https://peopleconnecthrats-production.up.railway.app/candidates/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://peopleconnecthrats-production.up.railway.app/uploads/:path*"
    },
    {
      "source": "/oauth/:path*",
      "destination": "https://peopleconnecthrats-production.up.railway.app/oauth/:path*"
    },
    {
      "source": "/sso/:path*",
      "destination": "https://peopleconnecthrats-production.up.railway.app/sso/:path*"
    },
    {
      "source": "/scim/:path*",
      "destination": "https://peopleconnecthrats-production.up.railway.app/scim/:path*"
    },
    {
      "source": "/client-portal/:path*",
      "destination": "https://peopleconnecthrats-production.up.railway.app/client-portal/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
