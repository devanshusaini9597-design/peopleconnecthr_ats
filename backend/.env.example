# Copy this file to .env and fill in real values. Never commit .env.
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
PORT=5000
JWT_SECRET=<generate a long random string, e.g. `openssl rand -hex 32`>
INTEGRATION_ENCRYPTION_KEY=<32-byte key for encrypting BYOK credentials at rest, e.g. `openssl rand -hex 32`>
FRONTEND_URL=http://localhost:5173
ENABLE_DEMO_LOGIN=false
NODE_ENV=development

# ── Stripe billing (backend/services/stripeService.js, routes/billingRoutes.js) ──
# Leave unset to disable self-serve billing (routes will return 503 with a clear message).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=

# ── Google Calendar OAuth (backend/routes/calendarOAuthRoutes.js) ──
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console,
# add {BACKEND_URL}/oauth/google-calendar/callback as an authorized redirect URI.
BACKEND_URL=http://localhost:5000
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ── SMS (Twilio) and AI (OpenAI) are configured per-organization via the
#    Integration Settings UI (BYOK) — no global env vars needed for those.

# ── SAML SSO (Enterprise plan only, backend/routes/ssoRoutes.js) ──
# No global env vars needed — each org's IdP entryPoint/cert is configured
# per-organization via PUT /api/sso/config. BACKEND_URL (set above) is used
# to build the SP's ACS/metadata URLs, so make sure it's set correctly in
# production (e.g. https://api.yourdomain.com).
