# Copy this file to .env and fill in real values. Never commit .env.
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
PORT=5000
JWT_SECRET=<generate a long random string, e.g. `openssl rand -hex 32`>
INTEGRATION_ENCRYPTION_KEY=<32-byte key for encrypting BYOK credentials at rest, e.g. `openssl rand -hex 32`>
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
# Comma-separated company domains that get Enterprise plan (others stay on free_trial/paid tiers).
# Example: ENTERPRISE_ORG_DOMAINS=skillnix.com,acme.co.in
ENTERPRISE_ORG_DOMAINS=skillnix.com
# Demo login credentials (overridable). Demo login route stays available.
DEMO_EMAIL=demo@skillnix.app
DEMO_PASSWORD=Demo1234!
NODE_ENV=development

# ── Redis (optional — enables BullMQ background jobs) ──
REDIS_URL=redis://localhost:6379

# ── Logging ──
LOG_LEVEL=info

# ── Stripe billing ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=

# ── Google Calendar OAuth ──
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ── Outlook Calendar OAuth (optional) ──
OUTLOOK_CALENDAR_CLIENT_ID=
OUTLOOK_CALENDAR_CLIENT_SECRET=
OUTLOOK_CALENDAR_TENANT_ID=

# ── S3 Resume Storage (optional — defaults to local uploads/) ──
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Email (Zoho ZeptoMail — required for verification / password reset) ──
# Use the Send Mail Token from ZeptoMail (may already include "Zoho-enczapikey ").
ZOHO_ZEPTOMAIL_API_KEY=
ZOHO_ZEPTOMAIL_FROM_EMAIL=noreply@yourdomain.com
ZOHO_ZEPTOMAIL_API_URL=https://api.zeptomail.in/
# Aliases also accepted: ZEPTOMAIL_API_KEY / ZEPTOMAIL_FROM_EMAIL
