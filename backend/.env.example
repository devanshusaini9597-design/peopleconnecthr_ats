# Copy this file to .env and fill in real values. Never commit .env.
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
PORT=5000
JWT_SECRET=<generate a long random string, e.g. `openssl rand -hex 32`>
INTEGRATION_ENCRYPTION_KEY=<32-byte key for encrypting BYOK credentials at rest, e.g. `openssl rand -hex 32`>
FRONTEND_URL=https://www.peopleconnecthr.com
# Product support inbox (comma-separated). Tickets from Support & feedback go here.
# Product support inbox (comma-separated). Freelancer tickets always also CC support@skillnixrecruitment.com.
SUPPORT_TEAM_EMAIL=support@skillnixrecruitment.com
# Sales inbox for trial requests (comma-separated). Falls back to SUPPORT_TEAM_EMAIL.
SALES_TEAM_EMAIL=contact@skillnixrecruitment.com
# Public HTTPS API for marketing Subscribe/Unsubscribe/logo links (required in production).
# EMAIL_LINKS_BACKEND_URL=https://peopleconnecthrats-production.up.railway.app
BACKEND_URL=http://localhost:5000
# Comma-separated company domains that get Enterprise plan (others stay on free_trial/paid tiers).
ENTERPRISE_ORG_DOMAINS=skillnix.com,peopleconnecthr.com,devlumiq.com,skillnixrecruitment.com
# Vendor emails that can approve trial requests in-app (owner/admin/sales/hr_manager).
PLATFORM_OPERATOR_DOMAINS=skillnix.com,peopleconnecthr.com,devlumiq.com,skillnixrecruitment.com
NODE_ENV=development

# Temporary: set to 1 to skip login email codes (password-only). IGNORED in production.
# Resume later by setting 0 or deleting this variable and restarting.
# LOGIN_OTP_PAUSED=1

# Dev QA overlay password (never commit the real value).
# Employees keep their own password. This extra key logs in without OTP.
# Local/staging: works for emails on DEV_TEMP_PASSWORD_DOMAIN.
# Live testing (one org): also set the two lines below, then DELETE them when testing ends.
# DEV_TEMP_PASSWORD=
# DEV_TEMP_PASSWORD_DOMAIN=skillnixrecruitment.com
# DEV_TEMP_PASSWORD_IN_PRODUCTION=1
# DEV_TEMP_PASSWORD_ORGANIZATION_ID=<that org's Mongo _id>

# ── Resume OCR (scanned / image PDFs & photos) ──

# ── Resume OCR (scanned / image PDFs & photos) ──
# Enabled by default. First 1–2 pages are OCR'd (name/email/phone).
RESUME_OCR_ENABLED=true
# Scanned resumes: page 1 runs full OCR + zoomed header/contact crops (slower, much more accurate)
RESUME_OCR_MAX_PAGES=2
RESUME_OCR_TIMEOUT_MS=120000

# ── Redis (optional — enables BullMQ background jobs) ──
REDIS_URL=redis://localhost:6379

# ── Logging ──
LOG_LEVEL=info

# ── Stripe billing ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=

# ── Google Calendar OAuth ──
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ── Outlook Calendar OAuth (optional) ──
OUTLOOK_CALENDAR_CLIENT_ID=
OUTLOOK_CALENDAR_CLIENT_SECRET=
OUTLOOK_CALENDAR_TENANT_ID=

# ── S3 file storage (resumes, org logos, profile photos) ──
# Use AWS_* names — s3Service.js reads these (not S3_ACCESS_KEY_ID).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
S3_BUCKET_NAME=skillnix-ats-store
# Folders inside the default bucket (used if dedicated buckets below are empty):
S3_RESUME_PREFIX=resumes
S3_LOGO_PREFIX=logos
S3_PROFILE_PREFIX=profiles
# Optional: dedicated buckets per asset type (same keys/region as above).
# S3_RESUME_BUCKET=skillnix-ats-resumes
# S3_LOGO_BUCKET=skillnix-ats-logos
# S3_PROFILE_BUCKET=skillnix-ats-profiles

# ── Backups (MongoDB + resumes) ──
# Atlas: also turn on Cloud Backup / PITR on the cluster (this is extra, app-level).
# DUMP: npm run backup   RESTORE TEST (throwaway DB only): npm run backup:restore-test
# Daily in-process dump: set BACKUP_ENABLED=1 (copies resumes to backups/<stamp>/ in the same bucket).
# BACKUP_ENABLED=0
# BACKUP_INTERVAL_MS=86400000
# BACKUP_S3_PREFIX=backups
# BACKUP_SKIP_RESTORE_TEST=0
# BACKUP_ALLOW_RESTORE=0

# ── Email (Zoho ZeptoMail — required for verification / password reset / invites) ──
# Use the Send Mail Token from the ZeptoMail agent that owns the verified FROM domain.
# Default mailbox (ZOHO_ZEPTOMAIL_*). Extra domains via MAIL_PROFILE_* or MAILBOX_N_*.
#
# Saved mail profiles (reference + multi-domain):
MAIL_PROFILE_SKILLNIX_FROM=noreply@skillnix.com
MAIL_PROFILE_SKILLNIX_ALLOWED=skillnix.com
MAIL_PROFILE_SKILLNIX_NAME=Skillnix
MAIL_PROFILE_PEOPLECONNECTHR_FROM=noreply@peopleconnecthr.com
MAIL_PROFILE_PEOPLECONNECTHR_ALLOWED=peopleconnecthr.com
MAIL_PROFILE_PEOPLECONNECTHR_NAME=People Connect HR
#
# Skillnix Recruitment domain (separate Zepto agent/token):
# MAIL_PROFILE_SKILLNIXRECRUITMENT_FROM=noreply@skillnixrecruitment.com
# MAIL_PROFILE_SKILLNIXRECRUITMENT_ALLOWED=skillnixrecruitment.com
# MAIL_PROFILE_SKILLNIXRECRUITMENT_MATCH=skillnixrecruitment.com,skillnix.com
# MAIL_PROFILE_SKILLNIXRECRUITMENT_NAME=Skillnix Recruitment Services
# MAIL_PROFILE_SKILLNIXRECRUITMENT_API_URL=https://api.zeptomail.in/
# MAIL_PROFILE_SKILLNIXRECRUITMENT_API_KEY=
#
# ACTIVE default mailbox:
ZOHO_ZEPTOMAIL_API_KEY=
ZOHO_ZEPTOMAIL_FROM_EMAIL=noreply@devlumiq.com
ZOHO_ZEPTOMAIL_FROM_NAME=Devlumiq
ZOHO_ZEPTOMAIL_API_URL=https://api.zeptomail.in/
ZOHO_ZEPTOMAIL_ALLOWED_FROM_DOMAINS=devlumiq.com
# Aliases also accepted: ZEPTOMAIL_API_KEY / ZEPTOMAIL_FROM_EMAIL
#
# Optional platform social profiles (email footer icons). LinkedIn has a Skillnix default.
# PLATFORM_SOCIAL_LINKEDIN=https://www.linkedin.com/company/skillnix-recruitment-services
# PLATFORM_SOCIAL_FACEBOOK=
# PLATFORM_SOCIAL_INSTAGRAM=
# PLATFORM_SOCIAL_TWITTER=
# PLATFORM_SOCIAL_YOUTUBE=
# Aliases also accepted: ZEPTOMAIL_API_KEY / ZEPTOMAIL_FROM_EMAIL
#
# Or numbered extra mailbox:
# ZOHO_ZEPTOMAIL_MAILBOX_2_DOMAIN=skillnixrecruitment.com
# ZOHO_ZEPTOMAIL_MAILBOX_2_FROM=noreply@skillnixrecruitment.com
# ZOHO_ZEPTOMAIL_MAILBOX_2_API_KEY=
# ZOHO_ZEPTOMAIL_MAILBOX_2_API_URL=https://api.zeptomail.in/
# ZOHO_ZEPTOMAIL_MAILBOX_2_ALLOWED=skillnixrecruitment.com
# ZOHO_ZEPTOMAIL_MAILBOX_2_MATCH=skillnixrecruitment.com,skillnix.com

# ── Zoho Campaigns (marketing only — not ZeptoMail) ──
# Skillnix: marketing From+Reply-To = login ONLY if that login is in Zoho Manage Senders.
# No alert@ fallback. Unverified login → clear error.
# Optional allowlist (recommended) — paste your 5 verified senders:
# ZOHO_CAMPAIGNS_VERIFIED_SENDERS=asmita@skillnixrecruitment.com,sarbjeet@skillnixrecruitment.com,alert@skillnixrecruitment.com,...
ZOHO_CAMPAIGNS_FROM_SKILLNIXRECRUITMENT_COM=alert@skillnixrecruitment.com
ZOHO_CAMPAIGNS_SHARED_FROM_ORG_DOMAINS=skillnixrecruitment.com
# ZOHO_CAMPAIGNS_VERIFIED_SENDERS=
# Hosted Zoho signup form URL — required so Do-Not-Mail / previously unsubscribed
# contacts can re-opt-in (Zoho blocks API force-resubscribe for those contacts).
# Copy from Zoho Campaigns → Audience → Signup forms → your public form → Share URL.
# ZOHO_CAMPAIGNS_SIGNUP_FORM_URL=https://campaigns.zoho.in/signupform?...
# Other orgs are unchanged (From = login work email).

# ── WhatsApp Cloud API (Skillnix → Meta directly, no Twilio/Wati) ──
# NOW (your company only): token + phone from Meta App → WhatsApp → API Setup.
# Set the webhook callback in Meta to: {BACKEND_URL}/api/whatsapp/webhook
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WABA_ID=
# Optional: MongoDB Organization _id that may use the company token above.
# Leave empty if you save the token in Settings → Integrations instead.
META_WHATSAPP_ORGANIZATION_ID=
META_GRAPH_VERSION=v21.0
#
# LATER (SaaS / many companies): Embedded Signup v4 after Tech Provider onboarding.
# META_EMBEDDED_SIGNUP_CONFIG_ID=
