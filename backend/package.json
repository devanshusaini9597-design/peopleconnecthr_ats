{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "node --max-old-space-size=4096 server.js",
    "dev": "nodemon --exec \"node --max-old-space-size=4096 server.js\"",
    "test": "jest --runInBand",
    "migrate:up": "migrate-mongo up",
    "migrate:down": "migrate-mongo down",
    "worker:resume": "node jobs/workers/resumeParseWorker.js",
    "worker:email": "node jobs/workers/emailWorker.js",
    "worker:webhook": "node jobs/workers/webhookWorker.js",
    "prepare": "cd .. && husky || true"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "./tests/setup.js"
    ],
    "testTimeout": 30000,
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.997.0",
